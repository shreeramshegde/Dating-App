# Server Port
SERVER_PORT=8080

# PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-or-postgres-host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_username>
SPRING_DATASOURCE_PASSWORD=<db_password>

# S3 / Object Storage Configuration
AWS_ENDPOINT_URL_S3=https://<storage-endpoint-url>
AWS_ACCESS_KEY_ID=<aws_or_neon_access_key>
AWS_SECRET_ACCESS_KEY=<aws_or_neon_secret_key>
AWS_REGION=us-east-2
AWS_S3_BUCKET=photos

# Security / JWT (Base64-encoded 256-bit secret)
JWT_SECRET=your-base64-encoded-secret-key-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000
